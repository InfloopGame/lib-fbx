{
  "name": "@infloopgame/lib-fbx",
  "version": "0.1.1",
  "description": "FBX 文件解析与处理库",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:binary": "tsx tests/fixtures/generate-binary.ts",
    "bench": "tsx scripts/fbx-benchmark.ts",
    "viewer": "vite --config tools/fbx-viewer/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests scripts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "keywords": [
    "fbx",
    "3d",
    "parser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InfloopGame/lib-fbx.git"
  },
  "bugs": {
    "url": "https://github.com/InfloopGame/lib-fbx/issues"
  },
  "homepage": "https://github.com/InfloopGame/lib-fbx#readme",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
